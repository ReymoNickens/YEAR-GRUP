# Copy to .env.local for local work. On Vercel, set these in Project → Settings → Environment Variables.
# Never commit real values.

# --- Supabase --------------------------------------------------------------
# Project settings → API keys. The publishable key is safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://bkdcgdwzekhqrpbecxgo.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Project settings → Database → Connection string → "Transaction pooler" (port 6543), with the database password.
DATABASE_URL=

# --- Payments --------------------------------------------------------------
# Paystack secret key, test key first (sk_test_...). Server only.
PAYSTACK_SECRET_KEY=
PUBLIC_APP_URL=http://localhost:3000

# --- Text messages ---------------------------------------------------------
# SMS_PROVIDER: arkesel, mnotify, or http (generic JSON gateway). Unset keeps codes off the wire.
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER=YearHub
SMS_API_URL=
# A long random string. Never change it once codes have been sent.
HUB_OTP_PEPPER=

# --- Scheduled jobs and operations ----------------------------------------
# Vercel Cron sends this as a bearer token. At least 24 random characters.
CRON_SECRET=
# Emails that may open /platform (EvolveIT staff only).
PLATFORM_ADMIN_EMAILS=

# --- Optional assistant polish (only the draft text is ever sent) ---------
AI_API_KEY=
AI_API_URL=
AI_MODEL=

# --- Local demonstration switches. Each is ignored in production. ---------
# HUB_DEV_OTP=1            show one-time codes on screen instead of texting them
# HUB_DEV_FOUNDER=1        the first real account becomes the first officers
# HUB_ALLOW_TEST_GATEWAY=1 show the "pay with test mobile money" button
# HUB_ALLOW_TEST_STEPUP=1  accept the word CONFIRM in place of a text-message code
